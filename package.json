{
  "name": "iceforge-kite-window",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS-backed kitesurfing suitability decision app",
  "workspaces": [
    "backend",
    "infrastructure"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p infrastructure/tsconfig.json",
    "test": "vitest run",
    "generate:types": "node tools/generate-types.mjs",
    "validate:schemas": "node tools/validate-schemas.mjs",
    "issues:list": "node tools/list-issues.mjs",
    "synth": "npm run synth --workspace infrastructure"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
