{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iceforge.io/schemas/spot.schema.json",
  "title": "Spot",
  "description": "Versioned spot configuration. Fields owned by provider-mapping and site-survey issues (NOAA tide station, NWS grid mapping, shore bearing, accepted/prohibited wind sectors) are optional here and must be listed in `unresolved` until validated.",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "spotId",
    "name",
    "location",
    "validationStatus",
    "active"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "version": {
      "description": "Configuration revision for this spot document, distinct from schemaVersion.",
      "type": "integer",
      "minimum": 1
    },
    "spotId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "municipality": { "type": "string", "minLength": 1 },
    "village": {
      "type": "string",
      "description": "Postal village or locality within the municipality, when the spot is known by a sub-municipal name.",
      "minLength": 1
    },
    "state": { "type": "string", "minLength": 1 },
    "region": { "type": "string" },
    "countryCode": { "type": "string", "minLength": 2, "maxLength": 2 },
    "location": {
      "type": "object",
      "description": "General spot location. latitude/longitude are optional until validated against an authoritative source; timezone is required.",
      "required": ["timezone"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "datum": {
          "type": "string",
          "description": "Geodetic datum for the coordinate pair, e.g. 'NAD83' or 'WGS84'.",
          "minLength": 1
        },
        "timezone": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "launchPoint": {
      "type": "object",
      "description": "Representative beach/launch coordinate, distinct from the spot's general location point.",
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "datum": {
          "type": "string",
          "description": "Geodetic datum for the coordinate pair, e.g. 'NAD83' or 'WGS84'.",
          "minLength": 1
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "shore": {
      "type": "object",
      "description": "Site-survey data owned by the shore-bearing/wind-sector follow-up issue. Absent until validated.",
      "properties": {
        "seawardBearingDegrees": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "acceptedWindSectors": {
          "type": "array",
          "items": { "$ref": "#/$defs/windSector" },
          "minItems": 1
        },
        "prohibitedWindSectors": {
          "type": "array",
          "items": { "$ref": "#/$defs/windSector" }
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "description": "Provider mappings for weather and tide data. Each sub-field is owned by a provider-adapter issue and absent until that issue resolves it.",
      "properties": {
        "noaaTideStation": { "$ref": "#/$defs/noaaTideStation" },
        "nwsGridpoint": {
          "type": "object",
          "description": "NWS grid endpoint and office, owned by issue #4.",
          "properties": {
            "office": { "type": "string", "minLength": 1 },
            "gridX": { "type": "integer" },
            "gridY": { "type": "integer" },
            "forecastEndpoint": { "type": "string", "minLength": 1 },
            "forecastHourlyEndpoint": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "defaultRulesetId": { "type": "string", "minLength": 1 },
    "validationStatus": {
      "enum": ["UNVALIDATED", "PARTIALLY_VALIDATED", "VALIDATED"]
    },
    "active": {
      "type": "boolean",
      "description": "Must be false until all required safety-critical fields (shore bearing, wind sectors, provider mappings) are validated."
    },
    "sourceNotes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "followUpIssue": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "noaaTideStation": {
      "type": "object",
      "description": "NOAA CO-OPS tide station used for tide predictions at this spot.",
      "required": [
        "stationId",
        "name",
        "stationType",
        "datum",
        "lat",
        "lng",
        "distanceKm",
        "availableProducts",
        "fallback"
      ],
      "properties": {
        "stationId": {
          "type": "string",
          "description": "NOAA CO-OPS station identifier (e.g. '8447504').",
          "pattern": "^[0-9]+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "stationType": {
          "enum": ["H", "S"],
          "description": "'H' = harmonic (reference) station with its own tidal constituents; 'S' = subordinate station using offset-adjusted predictions from a reference station."
        },
        "referenceStationId": {
          "type": "string",
          "description": "NOAA CO-OPS ID of the harmonic reference station. Required when stationType is 'S'.",
          "pattern": "^[0-9]+$"
        },
        "datum": {
          "type": "string",
          "description": "Tidal datum for height values returned by the predictions API (e.g. 'MLLW').",
          "minLength": 1
        },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "distanceKm": {
          "type": "number",
          "description": "Great-circle distance in kilometres from the spot's general location.",
          "exclusiveMinimum": 0
        },
        "availableProducts": {
          "type": "array",
          "description": "NOAA CO-OPS product identifiers confirmed available for this station (e.g. 'predictions').",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "predictionIntervals": {
          "type": "array",
          "description": "Confirmed prediction interval values (e.g. 'hilo', '6', 'h').",
          "items": { "type": "string", "minLength": 1 }
        },
        "fallback": { "$ref": "#/$defs/noaaTideStationFallback" }
      },
      "additionalProperties": false
    },
    "noaaTideStationFallback": {
      "type": "object",
      "description": "Policy for handling NOAA CO-OPS station retrieval failures.",
      "required": ["stations", "onAllFailed"],
      "properties": {
        "stations": {
          "type": "array",
          "description": "Ordered list of alternative stations to try, in preference order.",
          "items": {
            "type": "object",
            "required": ["stationId", "name", "reason"],
            "properties": {
              "stationId": { "type": "string", "pattern": "^[0-9]+$" },
              "name": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "onAllFailed": {
          "enum": ["NO_GO"],
          "description": "Action taken when all stations fail. 'NO_GO' — do not publish a forecast; surface an explicit error to the user."
        }
      },
      "additionalProperties": false
    },
    "windSector": {
      "type": "object",
      "required": ["startDegrees", "endDegrees", "classification", "accepted"],
      "properties": {
        "startDegrees": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "endDegrees": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "classification": {
          "enum": ["DIRECT_ONSHORE", "SIDE_ONSHORE", "CROSS_SHORE", "SIDE_OFFSHORE", "OFFSHORE"]
        },
        "accepted": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
