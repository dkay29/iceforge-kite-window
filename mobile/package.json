{
  "name": "iceforge-kite-window-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest --passWithNoTests",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.17",
    "@react-navigation/native-stack": "^7.2.0",
    "react": "^18.3.1",
    "react-native": "^0.76.7",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@babel/preset-env": "^7.25.9",
    "@babel/runtime": "^7.25.9",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/babel-preset": "^0.76.7",
    "@react-native/eslint-config": "^0.76.7",
    "@react-native/metro-config": "^0.76.7",
    "@react-native/typescript-config": "^0.76.9",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/react-native": "^0.72.8",
    "@types/react-test-renderer": "^18.3.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-screens|react-native-safe-area-context)/)"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/react-native/extend-expect"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
