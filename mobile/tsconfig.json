{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-native",
    "skipLibCheck": true,
    "types": ["jest", "react", "react-native"]
  },
  "include": ["src", "index.js", "index.ts"]
}
